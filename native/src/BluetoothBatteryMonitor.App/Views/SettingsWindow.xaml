<ui:FluentWindow x:Class="BluetoothBatteryMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BluetoothBatteryMonitor.App.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Settings_Title}"
        Width="540"
        Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,10,0,20">
            <TextBlock Text="{DynamicResource Settings_Header}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{DynamicResource Settings_SubHeader}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Ayar Kartları -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,0">
                <!-- Peripheral Battery tray appearance -->
                <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="托盘图标与颜色" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="预览为示例电量；保存后立即更新托盘。" FontSize="12" Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <StackPanel Margin="18,0"><Image x:Name="PreviewHigh" Width="32" Height="32"/><TextBlock Text="80%" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                            <StackPanel Margin="18,0"><Image x:Name="PreviewMid" Width="32" Height="32"/><TextBlock Text="30%" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                            <StackPanel Margin="18,0"><Image x:Name="PreviewLow" Width="32" Height="32"/><TextBlock Text="9%" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
                        </StackPanel>
                        <CheckBox Content="按电量自动变色" IsChecked="{Binding TrayAutoColor}" Margin="0,0,0,6"/>
                        <TextBlock Text="高于 30% 绿色 · 10%～30% 黄色 · 低于 10% 红色" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="充足电量" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="{Binding TrayHighColor}" Tag="TrayHighColor" Cursor="Hand" MouseLeftButtonUp="ChooseTrayColor" Width="16" Height="16" CornerRadius="4"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TrayHighColor,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="偏低电量" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="{Binding TrayMidColor}" Tag="TrayMidColor" Cursor="Hand" MouseLeftButtonUp="ChooseTrayColor" Width="16" Height="16" CornerRadius="4"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding TrayMidColor,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="极低电量" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border Grid.Row="2" Grid.Column="1" Background="{Binding TrayLowColor}" Tag="TrayLowColor" Cursor="Hand" MouseLeftButtonUp="ChooseTrayColor" Width="16" Height="16" CornerRadius="4"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding TrayLowColor,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="固定颜色（自动变色关闭时）" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border Grid.Row="3" Grid.Column="1" Background="{Binding TrayFixedColor}" Tag="TrayFixedColor" Cursor="Hand" MouseLeftButtonUp="ChooseTrayColor" Width="16" Height="16" CornerRadius="4"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding TrayFixedColor,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="颜色支持任意 #RRGGBB 色值。" FontSize="11" Margin="0,8,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                            <TextBlock Text="显示方式" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:SettingsViewModel.AvailableTrayStyles}" SelectedItem="{Binding TrayIconStyle}"/>
                        </Grid>
                        <TextBlock Text="圆环粗细" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Slider Minimum="7" Maximum="13" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrayRingWidth}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>


                <!-- 1. Başlangıçta Çalıştır -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_LaunchAtStartup}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_LaunchAtStartupDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2. Dil Seçimi (Language) -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_Language}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_LanguageDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                  Width="130"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. Arayüz Teması (Theme) -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_Theme}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_ThemeDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  Width="130"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4. Bildirimleri Etkinleştir -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_Notifications}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_NotificationsDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding EnableNotifications, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. Akıllı Ses Yönlendirici (Smart Audio Router) -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_AudioRouter}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_AudioRouterDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding AutoSwitchAudioEndpoint, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4. Yerel REST / JSON API Sunucusu -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_RestApi}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Settings_RestApiDesc}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding EnableRestApi, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Port ve Canlı URL Önizlemesi -->
                        <Grid Margin="0,10,0,2" IsEnabled="{Binding EnableRestApi}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings_RestApiPort}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding RestApiUrlPreview}"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RestApiPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Width="80"
                                     MaxLength="5"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Düşük Pil Eşiği -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Settings_LowThreshold}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding LowBatteryThresholdText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="#F59E0B" />
                        </Grid>
                        <Slider Minimum="15"
                                Maximum="40"
                                Value="{Binding LowBatteryThreshold, Mode=TwoWay}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Cihaz Bazlı Özel Bildirim Eşikleri -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_DeviceThresholds}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Settings_DeviceThresholdsDesc}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,8" />

                        <!-- Tanımlı Cihaz Eşikleri -->
                        <ItemsControl ItemsSource="{Binding DeviceThresholds}"
                                      Visibility="{Binding HasDeviceThresholds, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableThresholds}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding SelectedThreshold, Mode=TwoWay}"
                                                  Width="175"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- İpucu kutusu -->
                        <Border Padding="8,6"
                                CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Settings_DeviceThresholdsTip}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 6. Kritik Pil Eşiği -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Settings_CriticalThreshold}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding CriticalBatteryThresholdText}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="#EF4444" />
                        </Grid>
                        <Slider Minimum="5"
                                Maximum="15"
                                Value="{Binding CriticalBatteryThreshold, Mode=TwoWay}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 7. Tarama Sıklığı -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings_PollingFrequency}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Settings_PollingFrequencyDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Static vm:SettingsViewModel.AvailableRefreshIntervals}"
                                  SelectedValuePath="Seconds"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding RefreshIntervalSeconds, Mode=TwoWay}"
                                  Width="120"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 8. Yazılım Güncellemeleri (Software Updates) -->
                <Border Margin="0,0,0,12"
                        Padding="14,10"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Update_Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Update_Desc}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Update_CheckNow}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding CanCheckUpdates}"
                                    Padding="14,6"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Güncelleme Durum Mesajı -->
                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#3B82F6"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                        <!-- Yeni Sürüm İndirme Butonu -->
                        <Button Content="{DynamicResource Update_Download}"
                                Command="{Binding OpenUpdateDownloadCommand}"
                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Padding="16,6" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Kaydet Butonu -->
        <Border Grid.Row="2"
                Margin="0,16,0,0">
            <Button Content="{DynamicResource Settings_SaveAndClose}"
                    HorizontalAlignment="Right"
                    Click="OnSaveAndCloseClick"
                    Padding="20,8" />
        </Border>
    </Grid>
</ui:FluentWindow>
